  "sar": {
    "enabled": true,
    "stac": "https://planetarycomputer.microsoft.com/api/stac/v1/search",
    "tiler": "https://planetarycomputer.microsoft.com/api/data/v1/item/tiles/WebMercatorQuad/{z}/{x}/{y}@1x",
    "collections": [
      "sentinel-1-rtc",
      "sentinel-1-grd"
    ],
    "daysBefore": 30,
    "daysAfter": 30,
    "rescale": {
      "sentinel-1-rtc": "0,0.4",
      "sentinel-1-grd": "0,600"
    },
    "modes": [
      {
        "id": "db",
        "name": "Backscatter (dB)",
        "default": true,
        "expression": "10*log10({pol})",
        "rescale": "-22,0",
        "colormap": "gray",
        "info": "The standard way to read radar. Smooth surfaces such as standing water and wet scoured mud are dark; rough ground and buildings are bright. Raw linear backscatter renders almost black, which is why this is the default."
      },
      {
        "id": "water",
        "name": "Smooth-surface / water mask",
        "expression": "where({pol}<0.02,1,0)",
        "rescale": "0,1",
        "colormap": "blues",
        "info": "Thresholds low backscatter: standing water, saturated ground and smooth deposits. Indicative only. In steep terrain radar shadow also reads as smooth, so treat isolated patches on slopes with caution."
      },
      {
        "id": "rgb",
        "name": "False colour (dB VV / VH / ratio)",
        "expression": "10*log10(vv);10*log10(vh);10*log10(vv)-10*log10(vh)",
        "rescale": "-20,-2&rescale=-28,-10&rescale=2,12",
        "info": "Dual-polarisation composite on a dB scale. Vegetation is green, smooth and water-covered ground dark blue, built-up surfaces pale."
      }
    ]
  },
  "rawDataApi": "https://api-prod.raw-data.hotosm.org/v1",
  "excludeTitles": [
    "Land Use"
  ],
  "optical": {
    "enabled": true,
    "collection": "sentinel-2-l2a",
    "stac": "https://planetarycomputer.microsoft.com/api/stac/v1/search",
    "tiler": "https://planetarycomputer.microsoft.com/api/data/v1/item/tiles/WebMercatorQuad/{z}/{x}/{y}@1x",
    "daysBefore": 20,
    "daysAfter": 30,
    "maxCloud": 95,
    "modes": [
      {
        "id": "tci",
        "name": "True colour",
        "default": true,
        "assets": "B04,B03,B02",
        "rescale": "0,3000",
        "info": "Natural colour, 10 m."
      },
      {
        "id": "swir",
        "name": "SWIR false colour",
        "assets": "B12,B08,B04",
        "rescale": "0,4000",
        "info": "Cuts through haze and thin cloud. Water is very dark, wet ground dark blue, bare scoured land bright."
      },
      {
        "id": "ndwi",
        "name": "NDWI water index",
        "expression": "(B03-B08)/(B03+B08)",
        "rescale": "-1,1",
        "colormap": "rdbu",
        "info": "Normalised difference water index. Blue is water."
      }
    ]
  }
